# 洛克王国远行商人提醒 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# 游戏数据接口 API Key (必填)
# 获取方式: https://github.com/Entropy-Increase-Team/astrbot_plugin_rocom
ROCOM_API_KEY=sk-xxx

# ImgBB 图床 API Key (必填)
# 获取方式: https://api.imgbb.com/ 注册后获取
IMGBB_KEY=xxx

# Android NotifyMe 推送 UUID (选填，不填则跳过 Android 推送)
# 获取方式: NotifyMe App 内获取
# 支持多人：用英文逗号分隔多个 UUID
# 例如: NOTIFYME_UUID=uuid1,uuid2,uuid3
NOTIFYME_UUID=

# iOS Bark 推送 Key (选填，不填则跳过 iOS 推送)
# 获取方式: Bark App 内复制
# 支持多人：用英文逗号分隔多个 Key
# 例如: BARK_KEY=key1,key2
BARK_KEY=

# 自定义 Chromium 浏览器路径 (选填，Playwright 不支持的 Linux 发行版需要)
# 例如: /home/user/.cache/playwright-chromium/chrome-linux/chrome
CHROMIUM_PATH=
